{
  "name": "@lake-effect-life/backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "set CHOKIDAR_USEPOLLING=1&& ts-node-dev --respawn --transpile-only --poll server.ts",
    "start": "node dist/server.js",
    "build": "tsc",
    "db:migrate-lookups": "ts-node scripts/migrateLookupReferences.ts",
    "db:migrate-inventory-model": "ts-node scripts/migrateInventoryModel.ts",
    "db:migrate-commerce-model": "ts-node scripts/migrateCommerceModel.ts",
    "db:seed-transactions": "ts-node scripts/seedInventoryTransactions.ts",
    "db:seed-commerce-transactions": "ts-node scripts/seedCommerceTransactions.ts",
    "start:serverless": "serverless offline",
    "lint": "eslint . --ext .js,.ts,.tsx",
    "format": "prettier --check .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@codegenie/serverless-express": "^4.15.0",
    "@types/node": "^22.7.4",
    "aws-sdk": "^2.1691.0",
    "axios": "^1.7.7",
    "body-parser": "^1.20.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.2",
    "jwk-to-pem": "^2.0.7",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.13.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "serverless-offline": "^14.3.2",
    "ts-node-dev": "^2.0.0"
  },
  "lint-staged": {
    "*.{js,ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ]
  }
}
